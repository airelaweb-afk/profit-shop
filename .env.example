# --- Cuentas y Pro en la nube (Supabase). Vacío = modo local (cuentas en el navegador). ---
# Supabase → Project Settings → API. La anon key es pública por diseño (RLS protege los datos).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cobros ---
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_REVOLUT_PAYMENT_LINK=

# --- Claves Pro firmadas (plan B sin cuenta; opcional con Supabase) ---
# JWK público que te da /admin → Claves. Sin él, la web solo acepta la clave maestra de pruebas.
NEXT_PUBLIC_PRO_PUBLIC_KEY=
# Seriales revocados, separados por coma (p. ej. AB23CD,XY89ZK)
NEXT_PUBLIC_PRO_REVOKED=
