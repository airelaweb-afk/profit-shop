Options -MultiViews
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
</IfModule>
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

ErrorDocument 404 /404.html

# Hashed build files can be cached for a year. HTML stays fresh.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_next/static/" hashed_static
  Header set Cache-Control "public, max-age=31536000, immutable" env=hashed_static
</IfModule>
